{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci --prefix 'Member 1'",
  "buildCommand": "VITE_CARELOOP_BROWSER_DEMO=true npm run build --prefix 'Member 1'",
  "outputDirectory": "Member 1/dist",
  "rewrites": [
    { "source": "/((?!assets/|api/).*)", "destination": "/index.html" }
  ]
}
