{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "member1": {
      "root": "Member 1",
      "framework": "vite",
      "installCommand": "npm ci",
      "buildCommand": "npm run build",
      "outputDirectory": "dist",
      "rewrites": [
        {
          "source": "/((?!assets/|api/).*)",
          "destination": "/index.html"
        }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "member1"
      }
    }
  ]
}
