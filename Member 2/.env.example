# CARELOOP Member 2 - Backend Environment Configuration
# Copy to .env or configure in Cloudflare Workers / Wrangler secrets

# Application Environment
ENVIRONMENT=development
PORT=8787

# Database (Cloudflare D1 Binding: DB)
# In local development without Cloudflare Wrangler, an in-memory or file-based SQLite database is used automatically.
DATABASE_PATH=careloop-local.sqlite

# CORS Configuration
# Set to frontend origin in production (e.g., https://careloop.health or http://localhost:5173 for local Vite dev)
CORS_ORIGIN=*

# Frontend Integration (Member 3 Admin & Member 1 Patient Webapp)
# In the host Vite app, set:
# VITE_CARELOOP_USE_DEMO_DATA=false
# VITE_CARELOOP_API_URL=http://localhost:8787
